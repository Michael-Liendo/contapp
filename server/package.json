{
	"name": "@contapp/server",
	"version": "0.3.0",
	"description": "the server for contapp",
	"type": "commonjs",
	"main": "src/index.ts",
	"scripts": {
		"start": "NODE_ENV=production node dist/src/index.js",
		"dev": "tsx src/index.ts",
		"dev:watch": "tsx watch src/index.ts",
		"build": "tsc",
		"migrations:make": "knex migrate:make -x ts",
		"migrations:up": "knex migrate:latest",
		"migrations:down": "knex migrate:down",
		"lint": "biome format ./ && biome check ./",
		"format": "biome format --write ./ && biome check --write ./",
		"format:unsafe": "biome format --write ./ && biome check --write --unsafe ./"
	},
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/Michael-Liendo/contapp.git"
	},
	"keywords": ["server"],
	"author": "Michael Liendo <contact@michaelliendo.com> (https://michaelliendo.com/)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/Michael-Liendo/contapp/issues"
	},
	"homepage": "https://github.com/Michael-Liendo/contapp#readme",
	"dependencies": {
		"@contapp/shared": "^0.0.1",
		"@fastify/cors": "^8.5.0",
		"@types/jsonwebtoken": "^9.0.7",
		"bcrypt": "^5.1.1",
		"dotenv": "^16.4.7",
		"fastify": "^5.7.4",
		"fastify-plugin": "^4.5.1",
		"firebase-admin": "^13.2.0",
		"google-auth-library": "^9.15.1",
		"http-status-codes": "^2.3.0",
		"jsonwebtoken": "^9.0.2",
		"knex": "^3.1.0",
		"pg": "^8.13.1",
		"ts-node": "^10.9.2",
		"tsx": "^4.19.2",
		"validator": "^13.12.0",
		"zustand": "^4.5.5"
	},
	"devDependencies": {
		"@types/bcrypt": "^5.0.2",
		"@types/node": "^20.14.10",
		"@types/validator": "^13.12.2",
		"typescript": "^5.7.2"
	}
}
